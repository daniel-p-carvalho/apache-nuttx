#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_EV49N51A

config EV49N51A_PHY_INTERRUPT
	bool "LAN8720A interrupt on RK6"
	default n
	depends on PIC32MZ_ETHERNET
	select ARCH_PHY_INTERRUPT
	select PIC32MZ_GPIOIRQ
	select PIC32MZ_GPIOIRQ_PORTK
	---help---
		Use the LAN8720A nINT output as a link up/down interrupt (for
		example for NETINIT_MONITOR).  nINT reaches RK6 only through R309,
		which is not fitted on the EV49N51A, so select this option only if
		R309 is fitted or nINT is otherwise wired to RK6.

config EV49N51A_BRIDGE_BOOT
	bool "Start a Wi-Fi AP bridged to Ethernet at boot"
	default n
	depends on ETC_ROMFS && NET_BRIDGE && SYSTEM_BRCTL && PIC32MZ_W1_WLAN && PIC32MZ_ETHERNET
	---help---
		Install /etc/init.d/rcS that configures wlan0 as a SoftAP, creates
		br0 and adds eth0 and wlan0 as bridge ports.

if EV49N51A_BRIDGE_BOOT

config EV49N51A_BRIDGE_SSID
	string "SoftAP SSID"
	default "NuttX-BR"

config EV49N51A_BRIDGE_PSK
	string "SoftAP passphrase (8..63 characters)"
	default "nuttxbridge"

config EV49N51A_BRIDGE_CHANNEL
	int "SoftAP 2.4 GHz channel"
	default 6
	range 1 13

config EV49N51A_BRIDGE_WPA3
	bool "WPA3-Personal (SAE) instead of WPA2-PSK"
	default n
	depends on PIC32MZ_W1_BA414E
	---help---
		Configure the SoftAP for WPA3-Personal.  Stations that only
		support WPA2 cannot join.  Needs the BA414E engine and its
		microcode (see the PIC32MZ_W1_BA414E options).

config EV49N51A_BRIDGE_IPADDR
	string "br0 IPv4 address"
	default "10.0.0.2"
	---help---
		Address of the bridge interface itself (eth0 and wlan0 stay at
		0.0.0.0).  The netmask is 255.255.255.0.

config EV49N51A_BRIDGE_DHCPD
	bool "Run the DHCP server on br0"
	default n
	depends on EXAMPLES_DHCPD
	---help---
		Serve leases on br0 from the board.  Leave disabled when another
		DHCP server is reachable through the bridge.

endif # EV49N51A_BRIDGE_BOOT

endif # ARCH_BOARD_EV49N51A
